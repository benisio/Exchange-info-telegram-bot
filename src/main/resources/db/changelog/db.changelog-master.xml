<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.21.xsd">

  <changeSet id="001_create_users_table" author="Denis Styopshin">
    <createTable tableName="users">
      <column name="telegram_user_id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="first_name" type="VARCHAR(100)"/>
      <column name="last_name" type="VARCHAR(100)"/>
      <column name="telegram_username" type="VARCHAR(100)"/>
      <column name="registered_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP"/>
    </createTable>

    <createTable tableName="users_display_currencies">
      <column name="user_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="currency_pair" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey
      columnNames="user_id,currency_pair"
      constraintName="users_display_currencies_pk"
      tableName="users_display_currencies"/>

    <addForeignKeyConstraint
      baseTableName="users_display_currencies"
      baseColumnNames="user_id"
      referencedTableName="users"
      referencedColumnNames="telegram_user_id"
      constraintName="users_display_currencies_fk"
      onDelete="CASCADE"/>
  </changeSet>

</databaseChangeLog>